generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  cedula           String?   @unique
  role             Role      @default(ADMIN)
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ingresosCreados  Ingreso[] @relation("IngresosCreados")
  gastosCreados    Gasto[]   @relation("GastosCreados")
  abonosCreados    Abono[]   @relation("AbonosCreados")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENTAS
  PRODUCCION
  SOLO_LECTURA
}

model Client {
  id                String          @id @default(cuid())
  name              String
  // Razón social / negocio. Opcional: para registrar un cliente bastan
  // nombre, contacto, correo y cédula o RUC.
  business          String?
  contact           String?
  whatsapp          String?
  email             String?
  // Cédula o RUC para facturación ante el SRI
  cedulaRuc         String?
  status            ClientStatus    @default(ACTIVE)
  notes             String?
  servicePlanId     String?
  servicePlan       ServicePlan?    @relation(fields: [servicePlanId], references: [id])
  clientPortalToken String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  monthlyPlans      MonthlyPlan[]
  contents          Content[]
  ingresos          Ingreso[]
  projects          ClientProject[]
  deliveryAccesses  DeliveryAccess[]
}

enum ServicePlanType {
  CONTENIDO
  IA
  FOTOGRAFIA
  PERSONALIZADO
}

enum Modalidad {
  MENSUAL
  OCASIONAL
}

model ServicePlan {
  id                         String          @id @default(cuid())
  nombre                     String
  tipo                       ServicePlanType
  modalidad                  Modalidad       @default(MENSUAL)
  precio                     Float
  cantidadReels              Int             @default(0)
  cantidadVideosHorizontales Int             @default(0)
  cantidadFotos              Int             @default(0)
  cantidadImagenesFlyers     Int             @default(0)
  jornadasGrabacion          Int             @default(0)
  duracion                   String?
  vestuarios                 Int             @default(0)
  descripcion                String?
  caracteristicas            String[]
  esDefault                  Boolean         @default(false)
  activo                     Boolean         @default(true)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  clients                    Client[]
  projects                   ClientProject[]
  monthlyPlans               MonthlyPlan[]
}

enum ClientStatus {
  ACTIVE
  PAUSED
  FINISHED
}

model MonthlyPlan {
  id             String          @id @default(cuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  servicePlanId  String?
  servicePlan    ServicePlan?    @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  month          Int
  year           Int
  reelsCount     Int             @default(0)
  carouselsCount Int             @default(0)
  flyersCount    Int             @default(0)
  // LEGACY: usar precioFinal como fuente de verdad; mantener por compatibilidad con registros anteriores
  monthlyPrice   Float           @default(0)
  // LEGACY: el estado real se calcula desde los Ingreso asociados; mantener por compatibilidad
  paymentStatus  PaymentStatus   @default(PENDING)
  planStatus     PlanStatus      @default(IN_PROGRESS)
  deliveryLink   String?
  observations   String?
  // Precio base copiado del ServicePlan al momento de crear el plan
  precioBase     Float?
  // Precio final acordado con el cliente (editable sobre el precio base)
  precioFinal    Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contents         Content[]
  projects         ClientProject[]
  ingresos         Ingreso[]
  deliveryAccesses DeliveryAccess[]

  @@unique([clientId, month, year])
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PlanStatus {
  IN_PROGRESS
  COMPLETED
  DELAYED
}

// Estados de producción vigentes: CONFIRMADO → GRABADO → EN_EDICION → ENTREGADO.
// El estado de pago es independiente y se calcula desde los Ingreso del proyecto,
// de modo que un trabajo puede estar ENTREGADO y seguir pendiente de cobro.
// Los demás valores son legacy: los conservan proyectos anteriores al cambio.
enum ProjectStatus {
  CONFIRMADO
  GRABADO
  EN_EDICION
  ENTREGADO
  PENDIENTE
  EN_PROCESO
  APROBADO
  COMPLETADO
  ATRASADO
}

model ClientProject {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       ServicePlan?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  monthlyPlanId String?
  monthlyPlan   MonthlyPlan?  @relation(fields: [monthlyPlanId], references: [id], onDelete: SetNull)
  nombre        String
  // Descripción general del servicio contratado, en los términos acordados
  descripcion   String?
  modalidad     Modalidad     @default(OCASIONAL)
  estado        ProjectStatus @default(CONFIRMADO)
  linkEntrega   String?
  // Carpeta de Google Drive donde se organizan los archivos finales
  driveLink     String?
  // Fecha de grabación o sesión; alimenta el calendario junto con fechaEntrega
  fechaGrabacion DateTime?
  fechaEntrega  DateTime?
  // Notas internas. NO se publican en el portal de entrega.
  observaciones String?
  // Mensaje de agradecimiento que ve el cliente en el portal de entrega.
  // Si está vacío se usa uno por defecto con el nombre del cliente.
  mensajeEntrega String?
  // Precio base copiado del ServicePlan al momento de crear el proyecto
  precioBase    Float?
  // Precio final acordado con el cliente (editable sobre el precio base)
  precioFinal   Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  contents         Content[]
  ingresos         Ingreso[]
  deliveryAccesses DeliveryAccess[]
  documentos       Documento[]
  gastos           Gasto[]
  calendarEvents   CalendarEvent[]
}

model Content {
  id            String         @id @default(cuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId        String?
  plan          MonthlyPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  projectId     String?
  project       ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type          ContentType
  formato       ContentFormat?
  title         String
  status        ContentStatus  @default(PENDING)
  requierePublicacion         Boolean       @default(false)
  driveLink     String?
  publishedLink String?
  publishedAt   DateTime?
  fechaEntrega   DateTime?
  fechaPublicacion DateTime?
  views         Int            @default(0)
  likes         Int            @default(0)
  comments      Int            @default(0)
  shares        Int            @default(0)
  saves         Int            @default(0)
  reach          Int            @default(0)
  impressions    Int            @default(0)
  observations  String?
  ultimaActualizacionMetricas DateTime?
  fuenteMetricas String?
  estadoSincronizacion SyncStatus @default(MANUAL)
  errorSincronizacion String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum ContentType {
  REEL
  CAROUSEL
  FLYER
  VIDEO_HORIZONTAL
  FOTO
  IMAGEN_FLYER
  EXTRA
  VIDEO
  OTRO
}

enum ContentFormat {
  VERTICAL_9_16
  HORIZONTAL_16_9
  CUADRADO_1_1
  NO_APLICA
}

enum ContentStatus {
  PENDING
  EDITING
  APPROVED
  PUBLISHED
  COMPLETED
  PENDIENTE
  EN_PROCESO
  ENTREGADO
  PUBLICADO
}

enum SyncStatus {
  MANUAL
  PENDIENTE
  ACTUALIZADO
  PENDING
  SYNCED
  ERROR
}

enum TipoServicio {
  FOTOGRAFIA
  REELS
  VIDEOS_HORIZONTALES
  IMAGENES_FLYERS
  PLAN_MENSUAL
  PERSONALIZADO
}

enum EstadoPago {
  PAGADO
  PENDIENTE
  PARCIAL
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  TARJETA
  OTRO
}

model Ingreso {
  id            String         @id @default(cuid())
  clienteId     String?
  cliente       Client?        @relation(fields: [clienteId], references: [id])
  // Vínculo al origen operativo (nullable para mantener ingresos legacy sin relación)
  projectId     String?
  project       ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  monthlyPlanId String?
  monthlyPlan   MonthlyPlan?   @relation(fields: [monthlyPlanId], references: [id], onDelete: SetNull)
  tipoServicio  TipoServicio
  descripcion   String?
  monto         Float
  montoPagado   Float          @default(0)
  estadoPago    EstadoPago     @default(PENDIENTE)
  metodoPago    MetodoPago?
  fechaIngreso  DateTime       @default(now())
  observaciones String?
  creadoPor     String
  creadoPorUser User           @relation("IngresosCreados", fields: [creadoPor], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  abonos        Abono[]
  documentos    Documento[]
}

// ── Documentos adjuntos ───────────────────────────────────────
//
// Archivos que respaldan un proyecto o un movimiento de dinero: la cotización
// aprobada, la factura emitida por el SRI (PDF y XML) o un comprobante de pago.
// El binario vive en disco (ver src/lib/storage.ts); aquí queda su metadato.

enum TipoDocumento {
  COTIZACION
  FACTURA_PDF
  FACTURA_XML
  COMPROBANTE
  OTRO
}

model Documento {
  id             String        @id @default(cuid())
  tipo           TipoDocumento
  // Nombre con el que el usuario subió el archivo, para mostrarlo y descargarlo
  nombreOriginal String
  // Nombre interno en el almacén; nunca se construye con datos del usuario
  archivo        String        @unique
  mimeType       String
  tamanoBytes    Int
  // Número de factura cuando corresponda (SRI)
  numeroFactura  String?
  projectId      String?
  project        ClientProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ingresoId      String?
  ingreso        Ingreso?       @relation(fields: [ingresoId], references: [id], onDelete: Cascade)
  gastoId        String?
  gasto          Gasto?         @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  subidoPor      String
  createdAt      DateTime       @default(now())

  @@index([projectId])
  @@index([ingresoId])
  @@index([gastoId])
  @@index([tipo])
}

model Abono {
  id            String      @id @default(cuid())
  ingresoId     String
  ingreso       Ingreso     @relation(fields: [ingresoId], references: [id], onDelete: Cascade)
  monto         Float
  metodoPago    MetodoPago?
  fechaAbono    DateTime    @default(now())
  observacion   String?
  creadoPor     String
  creadoPorUser User        @relation("AbonosCreados", fields: [creadoPor], references: [id])
  createdAt     DateTime    @default(now())
}

// ── Gastos ────────────────────────────────────────────────────
//
// Las categorías viven en su propia tabla para poder ampliarlas desde la
// aplicación, sin tocar el código ni desplegar.

model CategoriaGasto {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  // Las categorías base no se pueden eliminar, solo desactivar
  esDefault   Boolean  @default(false)
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gastos      Gasto[]
}

enum EstadoGasto {
  PAGADO
  PENDIENTE
}

model Gasto {
  id            String         @id @default(cuid())
  fecha         DateTime
  concepto      String
  categoriaId   String
  categoria     CategoriaGasto @relation(fields: [categoriaId], references: [id])
  monto         Float
  proveedor     String?
  metodoPago    MetodoPago?
  estado        EstadoGasto    @default(PAGADO)
  // Con proyecto: afecta el resultado de ese trabajo.
  // Sin proyecto: gasto general de la empresa.
  projectId     String?
  project       ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  observaciones String?
  creadoPor     String
  creadoPorUser User           @relation("GastosCreados", fields: [creadoPor], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documentos    Documento[]

  @@index([fecha])
  @@index([categoriaId])
  @@index([projectId])
  @@index([estado])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ── Google Calendar Token (singleton) ────────────────────────

model GoogleToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

// ── Delivery Access (links privados de entrega) ──────────────

enum DeliveryAccessType {
  PROJECT
  MONTHLY_PLAN
  CLIENT_GENERAL
}

model DeliveryAccess {
  id             String             @id @default(cuid())
  token          String             @unique
  publicSlug     String?            @unique
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String?
  project        ClientProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  monthlyPlanId  String?
  monthlyPlan    MonthlyPlan?       @relation(fields: [monthlyPlanId], references: [id], onDelete: SetNull)
  type           DeliveryAccessType
  isActive       Boolean            @default(true)
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([token])
  @@index([publicSlug])
  @@index([clientId])
}

// ── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userEmail  String
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ── Módulo Calendario ─────────────────────────────────────────

enum EventType {
  GRABACION
  SESION_FOTOGRAFICA
  REUNION
  ENTREGA
  EDICION
  EVENTO
  OTRO
}

enum EventStatus {
  AGENDADO
  REALIZADO
  CANCELADO
}

enum EventSource {
  PHM
  GOOGLE
}

model CalendarEvent {
  id            String      @id @default(cuid())
  title         String
  type          EventType   @default(OTRO)
  startDateTime DateTime
  endDateTime   DateTime
  location      String?
  notes         String?
  clientId      String?
  clientName    String?
  // Proyecto que originó el evento. Permite mantener las fechas al día cuando
  // el proyecto se edita; antes solo se relacionaban por el texto de las notas,
  // que se perdía al renombrar el proyecto.
  projectId     String?
  project       ClientProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        EventStatus @default(AGENDADO)
  googleEventId String?
  source        EventSource @default(PHM)
  syncStatus    SyncStatus  @default(PENDING)
  // Momento de la última sincronización correcta con Google.
  //
  // Hace falta un campo propio: `updatedAt` se refresca en cada escritura, así
  // que marcar un evento como sincronizado lo hacía parecer "más nuevo" que su
  // versión en Google y los cambios hechos allí no volvían nunca. Comparando
  // contra esta marca se sabe de qué lado hubo un cambio real.
  lastSyncedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([googleEventId])
  @@index([projectId])
}
