# ──────────────────────────────────────────────────────
#  Configuración para envío de correos — Maverick Zambrano
#  Copia este archivo como .env y rellena los valores
# ──────────────────────────────────────────────────────

# Tu cuenta de Gmail
EMAIL_USER=tucorreo@gmail.com

# Contraseña de aplicación de Google (NO tu contraseña normal)
# Ver README.md para saber cómo generarla
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Link de Spotify del lanzamiento
SPOTIFY_LINK=https://open.spotify.com/intl-es/album/7gLEL6FDMPbbJINgFmsVcs?si=l8vG_TwWTVSngr6xXux0Jg

# Correo al que se envía en modo prueba
TEST_EMAIL=tucorreo@gmail.com

# URL pública del banner/portada del lanzamiento (opcional pero recomendado)
# Puede ser un enlace de Google Drive (compartido), Imgur, Dropbox, etc.
# Si se deja vacío, el correo muestra un banner de diseño con el nombre del artista.
BANNER_URL=
