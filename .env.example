# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/phm_sistema"

# Clave secreta para JWT (cámbiala por una cadena aleatoria larga)
JWT_SECRET="tu-clave-secreta-super-segura-cambiar-en-produccion"

# URL del sitio (para producción en VPS)
NEXTAUTH_URL="http://localhost:3000"

# Carpeta donde se guardan los documentos adjuntos (cotizaciones, facturas).
# En produccion debe apuntar FUERA del directorio de la app para que un
# despliegue no borre los archivos. Ej: /var/lib/phm/uploads
UPLOAD_DIR=
